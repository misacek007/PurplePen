From 8fcb478e709ce915831702980a6bdaf01cdcc9b9 Mon Sep 17 00:00:00 2001
From: Michal Novacek <mnovacek@redhat.com>
Date: Wed, 29 Jul 2026 10:20:49 +0200
Subject: [PATCH] Fix PdfConverter path for Linux and add linux-x64 publish profile

PdfMapFile.FindPdfConverterExe() hardcoded "PdfConverter.exe" which
does not exist on Linux — the self-contained publish produces a binary
named "PdfConverter" (no extension). Use OperatingSystem.IsWindows()
to select the correct name.

Add a linux-x64 publish profile mirroring the existing win-x64 one.

Co-Authored-By: Claude Opus 4.6 (1M context) <noreply@anthropic.com>
Signed-off-by: Michal Novacek <mnovacek@redhat.com>

---
 .../PublishProfiles/linux-x64.pubxml          | 15 ++++
 src/PurplePenCore/PdfMapFile.cs               | 83 ++++++++++---------
 2 files changed, 57 insertions(+), 41 deletions(-)
 create mode 100644 src/AvPurplePen/Properties/PublishProfiles/linux-x64.pubxml


diff --git a/src/AvPurplePen/Properties/PublishProfiles/linux-x64.pubxml b/src/AvPurplePen/Properties/PublishProfiles/linux-x64.pubxml
new file mode 100644
index 000000000..ec69b59be
--- /dev/null
+++ b/src/AvPurplePen/Properties/PublishProfiles/linux-x64.pubxml
@@ -0,0 +1,15 @@
+<Project>
+  <PropertyGroup>
+    <Configuration>Release</Configuration>
+    <Platform>Any CPU</Platform>
+    <PublishDir>bin\Release\net10.0\publish\linux-x64\</PublishDir>
+    <PublishProtocol>FileSystem</PublishProtocol>
+    <_TargetId>Folder</_TargetId>
+    <TargetFramework>net10.0</TargetFramework>
+    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
+    <SelfContained>true</SelfContained>
+    <PublishSingleFile>false</PublishSingleFile>
+    <PublishReadyToRun>false</PublishReadyToRun>
+    <PublishTrimmed>false</PublishTrimmed>
+  </PropertyGroup>
+</Project>
diff --git a/src/PurplePenCore/PdfMapFile.cs b/src/PurplePenCore/PdfMapFile.cs
index 815071b76..d141283c8 100644
--- a/src/PurplePenCore/PdfMapFile.cs
+++ b/src/PurplePenCore/PdfMapFile.cs
@@ -132,10 +132,10 @@ namespace PurplePen
                 return status;
             }
             catch (Exception e) {
-                status = ConversionStatus.Failure;
-
-                if (!string.IsNullOrWhiteSpace(pngFileName))
-                    File.Delete(pngFileName);
+                status = ConversionStatus.Failure;
+
+                if (!string.IsNullOrWhiteSpace(pngFileName))
+                    File.Delete(pngFileName);
 
                 conversionOutput = e.Message;
                 return status;
@@ -144,9 +144,9 @@ namespace PurplePen
 
         private void ProcessDataReceived(object sender, DataReceivedEventArgs e)
         {
-            lock (stderrOutput) {
-                stderrOutput.Append(e.Data);
-                stderrOutput.Append("\r\n");
+            lock (stderrOutput) {
+                stderrOutput.Append(e.Data);
+                stderrOutput.Append("\r\n");
             }
         }
 
@@ -154,16 +154,16 @@ namespace PurplePen
         {
             process.WaitForExit();
 
-            lock (stderrOutput) {
-                conversionOutput = stderrOutput.ToString();
+            lock (stderrOutput) {
+                conversionOutput = stderrOutput.ToString();
             }
 
             status = process.ExitCode == 0 ? ConversionStatus.Success : ConversionStatus.Failure;
             process.Dispose();
-            process = null;
-
-            if (status == ConversionStatus.Failure && !string.IsNullOrWhiteSpace(pngFileName))
-                File.Delete(pngFileName);
+            process = null;
+
+            if (status == ConversionStatus.Failure && !string.IsNullOrWhiteSpace(pngFileName))
+                File.Delete(pngFileName);
 
             if (ConversionCompleted != null)
                 ConversionCompleted(this, EventArgs.Empty);
@@ -171,51 +171,52 @@ namespace PurplePen
 
         internal string FindPdfConverterExe()
         {
-            Uri uri = new Uri(typeof(PdfMapFile).Assembly.Location);
-            string applicationDirectory = Path.GetDirectoryName(uri.LocalPath);
-            return Path.Combine(applicationDirectory, "PdfConverter.exe");
+            Uri uri = new Uri(typeof(PdfMapFile).Assembly.Location);
+            string applicationDirectory = Path.GetDirectoryName(uri.LocalPath);
+            string exeName = OperatingSystem.IsWindows() ? "PdfConverter.exe" : "PdfConverter";
+            return Path.Combine(applicationDirectory, exeName);
         }
 
         internal string GetCacheFileName(string path)
-        {
+        {
             string cacheDirectory = GetCacheDirectory();
 
             return Path.Combine(cacheDirectory, CalculateSha1(path) + ".png");
-        }
-
-        private static string GetCacheDirectory()
-        {
+        }
+
+        private static string GetCacheDirectory()
+        {
             string tempPath = Path.GetTempPath();
             string cacheDirectory = Path.Combine(tempPath, "PurplePen");
             if (!Directory.Exists(cacheDirectory))
-                Directory.CreateDirectory(cacheDirectory);
-            return cacheDirectory;
-        }
-
-        // Clean stale caches (over 6 months old).
-        private static void CleanCacheDirectory()
-        {
-            DateTime oldDate = DateTime.Now.Subtract(TimeSpan.FromDays(180));
+                Directory.CreateDirectory(cacheDirectory);
+            return cacheDirectory;
+        }
+
+        // Clean stale caches (over 6 months old).
+        private static void CleanCacheDirectory()
+        {
+            DateTime oldDate = DateTime.Now.Subtract(TimeSpan.FromDays(180));
             string cacheDirectory = GetCacheDirectory();
-
-            try {
-                foreach (string filename in Directory.GetFiles(cacheDirectory, "*.png", SearchOption.TopDirectoryOnly)) {
-                    FileInfo fileInfo = new FileInfo(filename);
-                    if (fileInfo.Exists && fileInfo.LastWriteTime < oldDate) {
-                        fileInfo.Delete();
-                    }
+
+            try {
+                foreach (string filename in Directory.GetFiles(cacheDirectory, "*.png", SearchOption.TopDirectoryOnly)) {
+                    FileInfo fileInfo = new FileInfo(filename);
+                    if (fileInfo.Exists && fileInfo.LastWriteTime < oldDate) {
+                        fileInfo.Delete();
+                    }
                 }
-            }
-            catch {
-                // Do nothing. Not a problem if we get an exception here.
+            }
+            catch {
+                // Do nothing. Not a problem if we get an exception here.
             }
         }
 
         internal string CalculateSha1(string path)
         {
             var hashAlgorithm = System.Security.Cryptography.SHA1.Create();
-            byte[] hash = hashAlgorithm.ComputeHash(File.ReadAllBytes(path));
-            hash[0] ^= 0xd9;   // Change hash so different from previous (GhostScript)
+            byte[] hash = hashAlgorithm.ComputeHash(File.ReadAllBytes(path));
+            hash[0] ^= 0xd9;   // Change hash so different from previous (GhostScript)
 #if !NETFRAMEWORK
             // NET CORE use different hash from NET Framework, because the converters are different.
             hash[1] ^= 0x7b;   


