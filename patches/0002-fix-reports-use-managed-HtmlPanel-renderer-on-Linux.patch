-                .Replace("<!--@@STYLES@@-->", viewModel.Styles ?? "")
-                .Replace("<!--@@BODY@@-->", viewModel.ReportBody ?? "");
-            reportWebView.NavigateToString(html);
+            string html = BuildHtml();
+
+            if (nativeWebView != null)
+                nativeWebView.NavigateToString(html);
+            else if (htmlPanel != null)
+                htmlPanel.Text = html;
+        }
+
+        /// <summary>
+        /// Assembles a full HTML document from the current ViewModel state.
