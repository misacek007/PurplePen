-            if (OperatingSystem.IsWindows() && this.ExpandWindow(printUiMinWidth, printUiMinHeight)) {
-                Dispatcher.UIThread.Post(() => reportWebView.ShowPrintUI(), DispatcherPriority.Background);
+            if (nativeWebView != null) {
+                // Windows: WebView2's print preview is rendered inside the web view, so a
+                // small dialog gives a cramped preview. Grow the window first if needed.
+                if (OperatingSystem.IsWindows() && this.ExpandWindow(printUiMinWidth, printUiMinHeight)) {
+                    Dispatcher.UIThread.Post(() => nativeWebView.ShowPrintUI(), DispatcherPriority.Background);
+                }
+                else {
+                    nativeWebView.ShowPrintUI();
+                }
             }
             else {
-                reportWebView.ShowPrintUI();
+                // Linux: HtmlPanel has no print API. Write the report to a temp file and
+                // open it in the default browser so the user can print from there.
+                PrintViaDefaultBrowser();
             }
         }
 
+        /// <summary>
+        /// Writes the report HTML to a temp file and opens it in the default browser.
+        /// </summary>
+        private void PrintViaDefaultBrowser()
+        {
+            string html = BuildHtml();
+            string tempFile = Path.Combine(Path.GetTempPath(), "PurplePen_Report.html");
+            File.WriteAllText(tempFile, html, System.Text.Encoding.UTF8);
+            Process.Start(new ProcessStartInfo(tempFile) { UseShellExecute = true });
+        }
