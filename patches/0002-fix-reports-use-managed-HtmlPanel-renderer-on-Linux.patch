+        private string BuildHtml()
+        {
+            return HtmlTemplate
+                .Replace("<!--@@TITLE@@-->", viewModel?.ReportTitle ?? "")
+                .Replace("<!--@@STYLES@@-->", viewModel?.Styles ?? "")
+                .Replace("<!--@@BODY@@-->", viewModel?.ReportBody ?? "");
         }
 
