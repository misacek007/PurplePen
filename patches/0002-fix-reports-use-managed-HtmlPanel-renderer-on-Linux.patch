     {
         private ReportDialogViewModel? viewModel;
 
+        // Platform-conditional rendering: exactly one of these is non-null.
+        private NativeWebView? nativeWebView;   // Windows (WebView2)
+        private HtmlPanel? htmlPanel;            // Linux (managed renderer)
+
         public ReportDialog()
         {
             InitializeComponent();
+
+            if (OperatingSystem.IsWindows()) {
+                nativeWebView = new NativeWebView { Background = Brushes.White };
+                reportContainer.Child = nativeWebView;
+            }
+            else {
+                htmlPanel = new HtmlPanel { Background = Brushes.White };
+                reportContainer.Child = htmlPanel;
+            }
+
             DataContextChanged += OnDataContextChanged;
         }
 
