<component type="desktop-application">
  <id>org.purplepen.PurplePen</id>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <name>Purple Pen</name>
  <summary>Course setting software for orienteering</summary>
  <description>
    <p>
      Purple Pen is a course setting program for orienteering races. It allows
      you to design orienteering courses on maps, manage control points, create
      course descriptions, and export materials for printing and race management.
    </p>
    <p>Features include:</p>
    <ul>
      <li>Design courses on OCAD and OpenMapper maps</li>
      <li>Automatic control descriptions (IOF symbols)</li>
      <li>Print courses, descriptions, and punch cards</li>
      <li>Export to PDF, OCAD, and image formats</li>
      <li>Relay and score course support</li>
      <li>Course variations and map exchanges</li>
    </ul>
  </description>
  <developer id="org.purplepen">
    <name>Peter Golde</name>
  </developer>
